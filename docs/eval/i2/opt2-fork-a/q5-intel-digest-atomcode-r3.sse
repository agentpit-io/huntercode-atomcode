data: {"type":"tool_result","id":"call_82259","name":"mcp__watchlist__stock_news","output":"{\"type\": \"stock_news\", \"code\": \"600519\", \"name\": \"600519\", \"items\": [{\"title\": \"南方基金旗下A500ETF南方(159352)标的指数飘红，业绩兑现驱动A股上行趋势有望进一步强化\", \"source\": \"界面新闻\", \"date\": \"2026-09-22\", \"url\": \"http://stock.eastmoney.com/a/202609223881190682.html\", \"impact\": \"neutral\", \"ai_note\": \"\", \"date_source\": \"从文章 URL 推断（上游未给日期字段）\"}, {\"title\": \"贵州茅台酱香酒营销有限公司陕西省区原副经理张丽萍接受纪律审查和监察调查\", \"source\": \"界面新闻\", \"date\": \"2026-09-22\", \"url\": \"http://finance.eastmoney.com/a/202609223881176469.html\", \"impact\": \"neutral\", \"ai_note\": \"\", \"date_source\": \"从文章 URL 推断（上游未给日期字段）\"}, {\"title\": \"【调仓】贵州茅台，纳入！800现金流ETF招商(159119)估值回落，份额连续3周增长！\", \"source\": \"界面新闻\", \"date\": \"2026-09-22\", \"url\": \"http://stock.eastmoney.com/a/202609223881157536.html\", \"impact\": \"neutral\", \"ai_note\": \"\", \"date_source\": \"从文章 URL 推断（上游未给日期字段）\"}, {\"title\": \"四季版系列茅台酒即将上线“i茅台”！贵州茅台股价上扬，食品饮料ETF华夏（515170）冲击4连阳\", \"source\": \"每日经济新闻\", \"date\": \"2026-09-22\", \"url\": \"http://stock.eastmoney.com/a/202609223881157129.html\", \"impact\": \"neutral\", \"ai_note\": \"\", \"date_source\": \"从文章 URL 推断（上游未给日期字段）\"}, {\"title\": \"A股成交额连续两日站上2万亿元！节前或延续震荡轮动，均衡型宽基沪深300ETF华夏（510330）受资金青睐\", \"source\": \"21世纪经济报道\", \"date\": \"2026-09-21\", \"url\": \"http://stock.eastmoney.com/a/202609213880023141.html\", \"impact\": \"neutral\", \"ai_note\": \"\", \"date_source\": \"从文章 URL 推断（上游未给日期字段）\"}, {\"title\": \"百元股六成来自电子与通信 AI产业链改写高价股版图\", \"source\": \"第一财经\", \"date\": \"2026-09-21\", \"url\": \"http://finance.eastmoney.com/a/202609213880006564.html\", \"impact\": \"neutral\", \"ai_note\": \"\", \"date_source\": \"从文章 URL 推断（上游未给日期字段）\"}, {\"title\": \"18只白酒股上涨 贵州茅台下跌0.36%\", \"source\": \"北京商报\", \"date\": \"2026-09-21\", \"url\": \"http://finance.eastmoney.com/a/202609213879993232.html\", \"impact\": \"neutral\", \"ai_note\": \"\", \"date_source\": \"从文章 URL 推断（上游未