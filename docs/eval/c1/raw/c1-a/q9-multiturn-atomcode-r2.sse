data: {"type":"tool_start","id":"call_b93c517a0e584716ab33036cbf80dbd7","name":"mcp__uzi__stock_deep_analysis","arguments":"{\"code\":\"601088\",\"depth\":\"lite\",\"outline\":\"### 一、毛利率核心指标\\n(提取并计算2026年中报或最新财报的毛利率具体数值，格式如：毛利率为 XX.XX%)\",\"_hermes_user_id\":\"c2126b72-f743-4307-b140-ceb3a9fe850e\"}","session_id":"93a0fee5-cc28-4704-8a36-e70d3e5952f6"}

