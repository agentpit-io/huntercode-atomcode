{
  // HunterCode · AtomCode 发行版 · MCP 挂载清单（M1）
  //
  // 全部 stdio —— AtomCode 5.1.0 支持 stdio 与 Streamable HTTP，我们这 9 个恰好全是 stdio。
  //
  // ${VAR} / ${VAR:-默认值} **由 AtomCode 自己展开**，这份文件原样铺进工作区、不预渲染。
  // 上游 mcp/config.rs:315-336 对 command / args / env 三处都调 expand_env_vars，
  // 支持的正是这两种写法（config.rs:797+ 有单测）。交给它展开的好处是
  // **kronos / truesource / hunter 系那几把 key 不会以明文落进工作区数据卷**，
  // 只在 daemon 进程的环境里存在（值从 deploy/.env 进容器环境）。
  //
  // 顺带一个反差：这个文件**可以**写 // 注释（AtomCode 的 mcp 配置解析器剥注释），
  // 但隔壁 .hooks.json **不行**（严格 JSON，解析失败还是静默的）——M1 踩过。
  //
  // autoApprove 是必须的：M0 实测 MCP 工具默认**每次调用都弹权限**
  // （/live 上是 permission_request），不预置的话用户每问一句行情都要点一次确认。
  // 实测 autoApprove 收的是**不带 mcp__ 前缀的工具原名**。
  //
  // **timeout_ms 同时是 `initialize` 的超时**，不只是工具调用的超时（M2 实测）。
  // 证据：一次 cargo 构建把机器压到 load 15 时，`/mcp/status` 里报
  // `MCP request initialize timed out after 60000ms` 的**恰好就是**当时
  // timeout_ms 写 60000 的那 5 个（akshare / watchlist / portfolio / screener /
  // hunter_user），而 ≥120000 的那 4 个（kronos / truesource / uzi / hunter_cap）
  // 一个没掉。Python MCP server 冷启动要 import 一大堆东西，2 核机器上被别的活
  // 占住时 60 秒不够。所以下面一律给到 ≥120000。（待办池 P2-7 由此定性）
  //
  // 上游依赖分两类：
  //   · akshare / kronos / truesource —— 直接打各自的上游（AKShare 数据源 / Hunter SaaS），
  //     不依赖本发行版的 api 服务。akshare 完全不需要 key。
  //   · uzi / watchlist / portfolio / screener / hunter_cap / hunter_user —— 薄代理，
  //     反调 HunterCode 后端 ${HERMES_API_URL}/api/internal/*。M1 的 compose 只起 daemon，
  //     **这 6 个能连上、能列工具，但真正调用需要 api 服务起来**（见 M1 报告 §6.3）。
  "mcpServers": {
    "akshare": {
      "command": "/opt/hca/venv/bin/akshare-mcp",
      "args": [],
      "env": {
        "AKSHARE_MCP_TRANSPORT": "stdio",
        "AKSHARE_MAX_ROWS": "${AKSHARE_MAX_ROWS:-50}",
        "AKSHARE_MAX_BYTES": "${AKSHARE_MAX_BYTES:-15000}"
      },
      "timeout_ms": 120000,
      "autoApprove": ["akshare_search", "akshare_signature", "akshare_call"]
    },
    "kronos": {
      "command": "/opt/hca/venv/bin/kronos-mcp",
      "args": [],
      "env": {
        // kronos / truesource 跑在 /opt/hca/venv 里（pip 装的包），import 不到
        // /opt/hca/mcp/ 下的大小闸 —— 靠 PYTHONPATH 让它们也能用上同一份。
        "PYTHONPATH": "/opt/hca/mcp",
        "HCA_MCP_MAX_BYTES": "${HCA_MCP_MAX_BYTES:-15000}",
        "KRONOS_MCP_TRANSPORT": "stdio",
        "KRONOS_API_KEY": "${KRONOS_API_KEY:-}",
        "KRONOS_BASE_URL": "${KRONOS_BASE_URL:-}"
      },
      // 一次推理 30-70 秒（上游 GPU 服务），超时给宽
      "timeout_ms": 120000,
      "autoApprove": ["kronos_health", "kronos_predict"]
    },
    "truesource": {
      "command": "/opt/hca/venv/bin/truesource-mcp",
      "args": [],
      "env": {
        "PYTHONPATH": "/opt/hca/mcp",
        "HCA_MCP_MAX_BYTES": "${HCA_MCP_MAX_BYTES:-15000}",
        "TRUESOURCE_MCP_TRANSPORT": "stdio",
        "HUNTER_API_KEY": "${HUNTER_API_KEY:-}",
        "TRUESOURCE_BASE_URL": "${TRUESOURCE_BASE_URL:-}"
      },
      // truesource_scout 单次 30-60 秒
      "timeout_ms": 120000,
      "autoApprove": [
        "truesource_procurement", "truesource_macro", "truesource_daily_brief",
        "truesource_alert_signals", "truesource_report", "truesource_scout"
      ]
    },
    "uzi": {
      "command": "/opt/hca/venv-hunter/bin/python",
      "args": ["/opt/hca/mcp/uzi_mcp.py"],
      "env": {
        "HERMES_API_URL": "${HERMES_API_URL:-http://api:8000}",
        "HCA_MCP_MAX_BYTES": "${HCA_MCP_MAX_BYTES:-15000}",
        "HUNTER_INTERNAL_KEY": "${HUNTER_INTERNAL_KEY:-}",
        "HUNTER_USER_ID": "${HUNTER_USER_ID:-}",
        "UZI_HTTP_TIMEOUT": "${UZI_HTTP_TIMEOUT:-170}"
      },
      // 必须 > UZI_HTTP_TIMEOUT，否则 MCP 这侧先掐断，模型只看到 "(pending / no output)"
      "timeout_ms": 180000,
      "autoApprove": ["stock_deep_analysis"]
    },
    "watchlist": {
      "command": "/opt/hca/venv-hunter/bin/python",
      "args": ["/opt/hca/mcp/watchlist_mcp.py"],
      "env": {
        "HERMES_API_URL": "${HERMES_API_URL:-http://api:8000}",
        "HCA_MCP_MAX_BYTES": "${HCA_MCP_MAX_BYTES:-15000}",
        "HUNTER_INTERNAL_KEY": "${HUNTER_INTERNAL_KEY:-}",
        "HUNTER_USER_ID": "${HUNTER_USER_ID:-}"
      },
      "timeout_ms": 120000,
      "autoApprove": [
        "stock_quickview", "stock_news", "watchlist_digest",
        "watchlist_rank", "watchlist_add", "watchlist_add_batch"
      ]
    },
    "portfolio": {
      "command": "/opt/hca/venv-hunter/bin/python",
      "args": ["/opt/hca/mcp/portfolio_mcp.py"],
      "env": {
        "HERMES_API_URL": "${HERMES_API_URL:-http://api:8000}",
        "HCA_MCP_MAX_BYTES": "${HCA_MCP_MAX_BYTES:-15000}",
        "HUNTER_INTERNAL_KEY": "${HUNTER_INTERNAL_KEY:-}",
        "HUNTER_USER_ID": "${HUNTER_USER_ID:-}"
      },
      "timeout_ms": 120000,
      "autoApprove": ["portfolio_rebalance", "portfolio_stress", "update_risk_profile"]
    },
    "screener": {
      "command": "/opt/hca/venv-hunter/bin/python",
      "args": ["/opt/hca/mcp/screener_mcp.py"],
      "env": {
        "HERMES_API_URL": "${HERMES_API_URL:-http://api:8000}",
        "HCA_MCP_MAX_BYTES": "${HCA_MCP_MAX_BYTES:-15000}",
        "HUNTER_INTERNAL_KEY": "${HUNTER_INTERNAL_KEY:-}"
      },
      "timeout_ms": 120000,
      "autoApprove": ["market_screen"]
    },
    "hunter_cap": {
      "command": "/opt/hca/venv-hunter/bin/python",
      "args": ["/opt/hca/mcp/hunter_capability_mcp.py"],
      "env": {
        "HERMES_API_URL": "${HERMES_API_URL:-http://api:8000}",
        "HCA_MCP_MAX_BYTES": "${HCA_MCP_MAX_BYTES:-15000}",
        "HUNTER_INTERNAL_KEY": "${HUNTER_INTERNAL_KEY:-}",
        "HUNTER_USER_ID": "${HUNTER_USER_ID:-}"
      },
      // skill_repo_open 要打 GitHub API + raw，国内网络下慢
      "timeout_ms": 120000,
      "autoApprove": ["skill_repo_open", "skill_repo_read", "skill_stage", "skill_staged"]
    },
    "hunter_user": {
      "command": "/opt/hca/venv-hunter/bin/python",
      "args": ["/opt/hca/mcp/hunter_user_mcp.py"],
      "env": {
        "HERMES_API_URL": "${HERMES_API_URL:-http://api:8000}",
        "HCA_MCP_MAX_BYTES": "${HCA_MCP_MAX_BYTES:-15000}",
        "HUNTER_INTERNAL_KEY": "${HUNTER_INTERNAL_KEY:-}",
        "HUNTER_USER_ID": "${HUNTER_USER_ID:-}"
      },
      "timeout_ms": 120000,
      "autoApprove": ["list_my_sources", "invoke"]
    }
  }
}
