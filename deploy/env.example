# HunterCode · AtomCode 发行版（HCA）· compose 环境变量样例
#
# 用法：cp deploy/env.example deploy/.env，改好后 bash deploy/up.sh
# deploy/.env 已经在 .gitignore 里 —— **不要把填好 key 的那份提交上去**。

# ── 模型通道（已拍板决策 3：安装时三选一，默认 OneAPI · Gemini 3.8）──────────
#
# 真正的上游网关地址。llm-shim 转发到这里。
# 默认是 HunterCode 的 OneAPI 网关；自建 OneAPI / 官方 Key / 本地 Ollama
# 都是改这一行（Ollama 填 http://宿主IP:11434/v1）。
HCA_LLM_UPSTREAM_URL=https://hunter.agentpit.io/api/saas/llm/v1

# daemon 实际去打的地址。**默认经过 llm-shim**。
#
# 为什么必须经过：M0 §11.2 实测，hunter 网关流式发并行 tool_calls 时**不带 index**，
# 守 OpenAI 协议的客户端（AtomCode 是 `tc.index.unwrap_or(0)`）会把多个工具调用
# 合并成一个脏调用（write_file 带上 bash 的 command），进而触发工具死循环。
# llm-shim 的 ToolCallIndexer 按 id 首次出现顺序把 index 补回去，网关本来就带
# index 时纯透传。**协议层已验证修好；端到端收益 M0 没测出来（待办池 P0-6）。**
#
# 想直连网关做对照：把这一行改成 ${HCA_LLM_UPSTREAM_URL} 的值。
HCA_LLM_BASE_URL=http://llm-shim:3999/v1

# 模型。M0 §11.3 实测 hunter-deep（Gemini 3.1 Pro）跑工具链明显更差
# （3 轮无一干净完成），默认继续用 hunter-chat（Gemini 3.8 Flash）。
HCA_LLM_MODEL=hunter-chat
HCA_LLM_PROVIDER_NAME=hunter
HCA_LLM_CONTEXT_WINDOW=1000000

# key 两种给法，二选一：
#   A) 放文件（推荐）——  把 key 文件放进 $HCA_SECRETS_DIR，这里填容器内路径。
#      好处是 key 不进环境变量，docker inspect 看不到。
#   B) 直接写 HCA_LLM_API_KEY=hunt_tools_xxx
HCA_LLM_API_KEY_FILE=/run/secrets/llm-key
#HCA_LLM_API_KEY=

# 宿主上存 key 的目录，只读挂到容器 /run/secrets。目录权限自己管好（700）。
HCA_SECRETS_DIR=./secrets

# ── MCP 依赖 ────────────────────────────────────────────────────────────────
#
# 六个 hunter 系 MCP（uzi / watchlist / portfolio / screener / hunter_cap /
# hunter_user）是薄代理，反调 HunterCode 后端的 /api/internal/*。
# **M1 的 compose 只起 daemon，没有 api 服务** —— 这六个能连上、能列工具，
# 但真正调用会连不上后端。api 进 compose 是 M2/M3 的事。
HERMES_API_URL=http://api:8000
HUNTER_INTERNAL_KEY=
# 单机单用户场景下给 MCP 一个固定用户身份（opencode 版是插件注入 _hermes_user_id，
# AtomCode 没有等价插件点 —— 待办池 P0-5，M2 定方案）
HUNTER_USER_ID=

# akshare 不需要 key。单次返回行数上限，防止一次拉回几万行撑爆上下文。
AKSHARE_MAX_ROWS=50

# kronos（清华 K 线预测）与 truesource（一手信号）需要各自的 key，
# 申请：https://hunter.agentpit.io/dev/api-keys
# 不填：MCP 照样能连上、能列工具，调用时明确告诉你去哪申请（不会假装成功）。
KRONOS_API_KEY=
HUNTER_API_KEY=

# ── hook（M4 全量：guard / context / lang / audit / budget）──────────────────
#
# guard 与 context 没有开关 —— 前者是本发行版唯一的硬约束，后者只注入真实时间与
# 资产清单。要临时停掉某个 hook，在工作区的 .hooks.json 里给它加 "disabled": true
# （上游 cc_hooks.rs:166 支持这个字段）。
#
# 语言硬约束（承接 opencode 的 hunter-lang 插件的提示词侧那一道）。
HCA_LANG_HOOK=1
# 审计日志。留空 = 工作区 .atomcode/audit.jsonl。超过 MAX_MB 轮转成 .1，只留一代。
HCA_AUDIT_LOG=
HCA_AUDIT_MAX_MB=64
HCA_AUDIT_RESP_HEAD=200
# 可选异步上报：填一个 URL 就会把每条审计记录 POST 过去（脱离进程组的子进程发，
# 不占 hook 的 timeout、失败不影响对话）。留空 = 只落本地文件。
HCA_AUDIT_WEBHOOK=
HCA_AUDIT_WEBHOOK_TOKEN=
# 预算闸 **默认关**（计划 v0.2 TP-05「默认关，与现状一致」）。
# 开了之后：Stop 事件记账（token 优先读会话 meta 的 turn_stats，覆盖不全就用
# 网关配额差值兜底），UserPromptSubmit 超阈值直接把这一轮退回。
# 三个上限都是 0 = 不限；只填其中一个也可以。
HCA_BUDGET_ENABLED=0
HCA_BUDGET_DAILY_TOKENS=0
HCA_BUDGET_DAILY_TOOL_CALLS=0
HCA_BUDGET_SESSION_TOOL_CALLS=0
# 配额接口（预算 hook 的 token 兜底源，与 tools/eval 同一个口子）
HCA_QUOTA_URL=https://hunter.agentpit.io/api/saas/llm/quota

# ── daemon ──────────────────────────────────────────────────────────────────
#
# 容器网络上的端口。按总控端口表**不发布到宿主**，只有 compose 内的 web/api 能连。
HCA_DAEMON_PORT=13456
# daemon 真正监听的回环端口（5.1.0 的 daemon 恒绑 127.0.0.1，没有 --host），
# 由容器内的 socat 转到上面那个端口。
HCA_DAEMON_INTERNAL_PORT=13457

# 每次启动是否用镜像里的模板重铺工作区的「发行版托管」文件
# （.atomcode.md / .mcp.json / .hooks.json / .hooks/ / .atomcode/skills/ / README / requirements）。
# 1 = 重铺（升级镜像即升级技能，默认）；0 = 保留你改过的那份。
# 用户资产目录（holdings/theses/factors/reports/scripts）任何时候都只铺一次。
HCA_WORKSPACE_REFRESH=1
# 每次启动是否按上面的变量重写 ~/.atomcode/config.toml。0 = 自己手工维护。
HCA_CONFIG_REFRESH=1

# 镜像 tag。up.sh 会用它构建与启动。
HCA_IMAGE_TAG=dev

# compose 项目名。同一台机器上装第二套时必须换一个名字 —— 容器名与**数据卷**
# 都按它隔离（install.sh --project 会写这一行）。
HCA_COMPOSE_PROJECT=hca

# ── 国内网络（M4 · TP-08「镜像与 npm 源可配置」）────────────────────────────
# 基础镜像前缀，**要带结尾的斜杠**。例：
#   docker.m.daocloud.io/        （DaoCloud 公共镜像站）
#   registry.cn-hangzhou.aliyuncs.com/library/
# 留空 = 直连 Docker Hub。三个自建镜像（daemon / web / llm-shim）都吃这一项。
HCA_BASE_IMAGE_PREFIX=
# npm 源（web 的 npm ci、daemon 取 AtomCode 官方二进制都会用）。
# ⚠ 换源之后 daemon 那边的 sha256 校验照旧 —— 镜像源上的包对不上会直接构建失败。
HCA_NPM_REGISTRY=
# pip / uv 源（daemon 镜像装 9 个 MCP 的依赖）。例：https://pypi.tuna.tsinghua.edu.cn/simple
HCA_PIP_INDEX_URL=

# ── 界面与后端（M3 · 计划 v0.2 TP-06 方案 B）────────────────────────────────
#
# web 是这个栈里**唯一对公网**的服务（总控端口表）。因此：
#   · HUNTER_SINGLE_USER 必须是 0（免登录开着 = 谁打开页面谁就是管理员）
#   · HUNTER_SETUP_TOKEN 必须非空
# up.sh 会检查这两条，不满足直接拒绝启动。
HCA_WEB_HOST_PORT=3200
# api 只绑回环，给脚本化核对用，不对公网
HCA_API_HOST_PORT=8200
HUNTER_SINGLE_USER=0
# invite：第一个注册的人自动是 admin，之后要邀请码。
# closed 连第一个管理员都建不出来，别用。
REGISTRATION_MODE=invite
# admin.txt 里那个账号的邮箱。留空用 admin@hca.agentpit.io
# 别用 .local/.localhost/.example/.test/.invalid —— api 的 email_validator 直接 422
HCA_ADMIN_EMAIL=
# 写进 admin.txt 的访问地址用哪个主机名（只影响那份提示文本）
HCA_PUBLIC_HOST=127.0.0.1
# 管理员白名单（逗号分隔）。**留空的话策略中心/回测页对管理员是 403** ——
# api 那边的判据是「JWT role == 'ADMIN'（大写）或 email 在这个白名单里」，
# 而库里 role 只存小写，所以白名单是唯一进得去的路。
# up.sh 第一次跑会按 HCA_ADMIN_EMAIL 自动补上，这里留空即可。
HUNTER_ADMIN_EMAILS=

# api 用的预构建镜像（公开 GHCR）。apps/api 的源码本仓库一行没改，
# 所以直接拉镜像，不在这里构建。
HUNTER_REGISTRY=ghcr.io/agentpit-io
HUNTER_VERSION=1.2.0

# 下面四项**留空即可**：up.sh 第一次跑会各生成一个 32 字节随机值写回 deploy/.env。
# 生成后不要再改 —— HCA_JWT_SECRET 一变所有人登录态失效，
# HCA_PG_PASSWORD 一变 api 直接连不上库。
HCA_PG_PASSWORD=
HCA_JWT_SECRET=
HUNTER_SETUP_TOKEN=
# HUNTER_INTERNAL_KEY 在上面「MCP 依赖」一节，留空同理（daemon/api/web 三家共用一把）

# 单轮上限（毫秒）。比 web 的 maxDuration=600s 稍短，让 BFF 先收尾、
# 给出「超时了」而不是被 Next 掐断连接。
HCA_TURN_TIMEOUT_MS=570000
# web 镜像构建时 next build 的堆上限（2 核 8G 机器上压到 3G，见 apps/web/Dockerfile）
HCA_WEB_BUILD_NODE_OPTIONS=--max-old-space-size=3072
# 管理员口令文件（admin.txt）写在哪。留空 = 跟 HCA_SECRETS_DIR 一起。
# HCA_SECRETS_DIR 是**只读挂进 daemon** 的，而 daemon 里跑着模型的 bash 工具；
# 想把管理员口令放到模型完全碰不到的地方，就在这里单独指一个目录。
HCA_ADMIN_SECRETS_DIR=
