# HunterCode · AtomCode 发行版（HCA）· compose 环境变量样例
#
# 用法：cp deploy/env.example deploy/.env，改好后 bash deploy/up.sh
# deploy/.env 已经在 .gitignore 里 —— **不要把填好 key 的那份提交上去**。

# ── 模型通道（已拍板决策 3：安装时三选一，默认 OneAPI · Gemini 3.8）──────────
#
# 真正的上游网关地址。llm-shim 转发到这里。
# 默认是 HunterCode 的 OneAPI 网关；自建 OneAPI / 官方 Key / 本地 Ollama
# 都是改这一行（Ollama 填 http://宿主IP:11434/v1）。
HCA_LLM_UPSTREAM_URL=https://hunter.agentpit.io/api/saas/llm/v1

# daemon 实际去打的地址。**默认经过 llm-shim**。
#
# 为什么必须经过：M0 §11.2 实测，hunter 网关流式发并行 tool_calls 时**不带 index**，
# 守 OpenAI 协议的客户端（AtomCode 是 `tc.index.unwrap_or(0)`）会把多个工具调用
# 合并成一个脏调用（write_file 带上 bash 的 command），进而触发工具死循环。
# llm-shim 的 ToolCallIndexer 按 id 首次出现顺序把 index 补回去，网关本来就带
# index 时纯透传。**协议层已验证修好；端到端收益 M0 没测出来（待办池 P0-6）。**
#
# 想直连网关做对照：把这一行改成 ${HCA_LLM_UPSTREAM_URL} 的值。
HCA_LLM_BASE_URL=http://llm-shim:3999/v1

# 模型。M0 §11.3 实测 hunter-deep（Gemini 3.1 Pro）跑工具链明显更差
# （3 轮无一干净完成），默认继续用 hunter-chat（Gemini 3.8 Flash）。
HCA_LLM_MODEL=hunter-chat
HCA_LLM_PROVIDER_NAME=hunter
HCA_LLM_CONTEXT_WINDOW=1000000

# key 两种给法，二选一：
#   A) 放文件（推荐）——  把 key 文件放进 $HCA_SECRETS_DIR，这里填容器内路径。
#      好处是 key 不进环境变量，docker inspect 看不到。
#   B) 直接写 HCA_LLM_API_KEY=hunt_tools_xxx
HCA_LLM_API_KEY_FILE=/run/secrets/llm-key
#HCA_LLM_API_KEY=

# 宿主上存 key 的目录，只读挂到容器 /run/secrets。目录权限自己管好（700）。
HCA_SECRETS_DIR=./secrets

# ── MCP 依赖 ────────────────────────────────────────────────────────────────
#
# 六个 hunter 系 MCP（uzi / watchlist / portfolio / screener / hunter_cap /
# hunter_user）是薄代理，反调 HunterCode 后端的 /api/internal/*。
# **M1 的 compose 只起 daemon，没有 api 服务** —— 这六个能连上、能列工具，
# 但真正调用会连不上后端。api 进 compose 是 M2/M3 的事。
HERMES_API_URL=http://api:8000
HUNTER_INTERNAL_KEY=
# 单机单用户场景下给 MCP 一个固定用户身份（opencode 版是插件注入 _hermes_user_id，
# AtomCode 没有等价插件点 —— 待办池 P0-5，M2 定方案）
HUNTER_USER_ID=

# akshare 不需要 key。单次返回行数上限，防止一次拉回几万行撑爆上下文。
AKSHARE_MAX_ROWS=50

# kronos（清华 K 线预测）与 truesource（一手信号）需要各自的 key，
# 申请：https://hunter.agentpit.io/dev/api-keys
# 不填：MCP 照样能连上、能列工具，调用时明确告诉你去哪申请（不会假装成功）。
KRONOS_API_KEY=
HUNTER_API_KEY=

# ── daemon ──────────────────────────────────────────────────────────────────
#
# 容器网络上的端口。按总控端口表**不发布到宿主**，只有 compose 内的 web/api 能连。
HCA_DAEMON_PORT=13456
# daemon 真正监听的回环端口（5.1.0 的 daemon 恒绑 127.0.0.1，没有 --host），
# 由容器内的 socat 转到上面那个端口。
HCA_DAEMON_INTERNAL_PORT=13457

# 每次启动是否用镜像里的模板重铺工作区的「发行版托管」文件
# （.atomcode.md / .mcp.json / .hooks.json / .hooks/ / .atomcode/skills/ / README / requirements）。
# 1 = 重铺（升级镜像即升级技能，默认）；0 = 保留你改过的那份。
# 用户资产目录（holdings/theses/factors/reports/scripts）任何时候都只铺一次。
HCA_WORKSPACE_REFRESH=1
# 每次启动是否按上面的变量重写 ~/.atomcode/config.toml。0 = 自己手工维护。
HCA_CONFIG_REFRESH=1

# 镜像 tag。up.sh 会用它构建与启动。
HCA_IMAGE_TAG=dev
